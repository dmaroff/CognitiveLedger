{
  "Agent": {
    "DevelopmentUserId": 1,
    "RequestTimeoutSeconds": 300,
    "MaximumToolIterations": 8
  },
  "LedgerMcp": {
    "Endpoint": "http://localhost:5185/mcp"
  },
  "Ollama": {
    "Endpoint": "http://127.0.0.1:11555",
    "ModelName": "qwen3:8b"
  },
  "AllowedHosts": "*",
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "Enrich": [
      "FromLogContext"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/cognitive-ledger-services-agentsapi-.log",
          "rollingInterval": "Day",
          "fileSizeLimitBytes": 5242880,
          "rollOnFileSizeLimit": true,
          "retainedFileCountLimit": 10,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}