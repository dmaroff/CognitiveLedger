<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:CognitiveLedger.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="CognitiveLedger.Desktop.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="CognitiveLedger.Desktop">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainViewModel />
    </Design.DataContext>

    <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Margin="8"
                   HorizontalAlignment="Center"
                   Text="AI: ready"
                   Foreground="Green"
                   IsVisible="{Binding IsAiReady}" />

        <StackPanel DockPanel.Dock="Top"
                    Orientation="Vertical"
                    Spacing="4"
                    Margin="8"
                    HorizontalAlignment="Center">

            <Button Content="Install AI"
                    Command="{Binding InstallAiCommand}"
                    IsVisible="{Binding !IsAiInstalled}"
                    HorizontalAlignment="Center" />

            <Button Content="Read Statement"
                    Command="{Binding ReadStatementCommand}"
                    IsVisible="{Binding IsAiReady}"
                    HorizontalAlignment="Center" />
        </StackPanel>
        
    </DockPanel>

</Window>
