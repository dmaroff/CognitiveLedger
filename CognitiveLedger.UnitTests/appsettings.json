{
  "AI": {
    "Provider": "OpenAI",
    "Model": "gpt-5.6-terra",
    "Endpoint": "https://api.openai.com/v1/responses",
    "RequestTimeoutSeconds": 300
  },
  "ConnectionStrings": {
    "CognitiveLedger": "Host=localhost;Port=5432;Database=cognitiveledger;Username=your_username;Password=your_password"
  },
  "Logging": {
    "MinimumLevel": "Information",
    "Console": {
      "SingleLine": true,
      "TimestampFormat": "HH:mm:ss.fff "
    },
    "File": {
      "Path": "logs/cognitive-ledger-.log",
      "RollingInterval": "Day",
      "FileSizeLimitBytes": 5242880,
      "RetainedFileCountLimit": 10,
      "Shared": true
    }
  }
}
