{
  "Logging": {
    "MinimumLevel": "Information",
    "Console": {
      "SingleLine": true,
      "TimestampFormat": "HH:mm:ss.fff "
    },
    "File": {
      "Path": "logs/cognitive-ledger-.log",
      "RollingInterval": "Day",
      "FileSizeLimitBytes": 5242880,
      "RetainedFileCountLimit": 10,
      "Shared": true
    }
  }
}
